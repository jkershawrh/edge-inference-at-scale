{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://evy.example/schemas/v2/chunk-record.schema.json", "title": "ChunkRecord",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "chunk_id", "parent", "content", "content_digest", "source_span", "section_path", "chunker", "language", "token_count", "scope"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "record_type": {"const": "chunk_record"}, "chunk_id": {"$ref": "#/$defs/id"},
    "parent": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "document_digest"], "properties": {"document_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}, "document_digest": {"$ref": "#/$defs/digest"}}},
    "content": {"type": "string", "minLength": 1}, "content_digest": {"$ref": "#/$defs/digest"},
    "source_span": {"type": "object", "additionalProperties": false, "required": ["unit", "start", "end"], "properties": {"unit": {"const": "unicode_code_point"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}},
    "section_path": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "chunker": {"type": "object", "additionalProperties": false, "required": ["name", "version", "configuration", "code_digest"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "configuration": {"type": "object"}, "code_digest": {"$ref": "#/$defs/digest"}}},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"}, "token_count": {"type": "integer", "minimum": 1},
    "scope": {"type": "object", "additionalProperties": false, "required": ["event_id", "geographies", "audiences"], "properties": {"event_id": {"$ref": "#/$defs/id"}, "geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
