{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evy.example/schemas/v1/audit-anchor-receipt.schema.json",
  "title": "CorpusAuditAnchorReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "receipt_id", "checkpoint", "witness", "signing_key", "revocation_snapshot", "signature"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "corpus_audit_anchor_receipt"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "checkpoint": {"$ref": "#/$defs/checkpoint"},
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "organization", "role", "signed_at"],
      "properties": {
        "identity": {"type": "string", "minLength": 3, "maxLength": 256},
        "organization": {"type": "string", "minLength": 1, "maxLength": 256},
        "role": {"const": "external-audit-witness"},
        "signed_at": {"type": "string", "format": "date-time"}
      }
    },
    "signing_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "role", "algorithm", "valid_from", "expires_at"],
      "properties": {
        "key_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "role": {"const": "audit-witness"},
        "algorithm": {"const": "Ed25519"},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "revocation_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "checked_at", "key_revoked_at", "key_revocation_reason"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "checked_at": {"type": "string", "format": "date-time"},
        "key_revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "key_revocation_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {"value": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_type", "checkpoint_id", "checkpoint_sequence", "ledger", "previous_anchor", "requester_identity", "created_at"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_type": {"const": "corpus_audit_checkpoint"},
        "checkpoint_id": {"$ref": "#/$defs/digest"},
        "checkpoint_sequence": {"type": "integer", "minimum": 1},
        "ledger": {
          "type": "object", "additionalProperties": false,
          "required": ["ledger_id", "entry_sequence", "entry_digest", "byte_size", "prefix_digest"],
          "properties": {
            "ledger_id": {"$ref": "#/$defs/id"}, "entry_sequence": {"type": "integer", "minimum": 1},
            "entry_digest": {"$ref": "#/$defs/digest"}, "byte_size": {"type": "integer", "minimum": 1}, "prefix_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "previous_anchor": {
          "type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_digest"],
          "properties": {"receipt_id": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "receipt_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}
        },
        "requester_identity": {"type": "string", "minLength": 3, "maxLength": 256},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
