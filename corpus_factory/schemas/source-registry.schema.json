{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evy.example/schemas/v2/source-registry.schema.json",
  "title": "ConnectedSourceRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "registry_id", "event_id", "version", "acquisition_policy_version", "sources"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "source_registry"},
    "registry_id": {"$ref": "#/$defs/id"},
    "event_id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/semver"},
    "acquisition_policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "steward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role"],
      "properties": {
        "identity": {"type": "string", "minLength": 3, "maxLength": 256},
        "role": {"type": "string", "minLength": 2, "maxLength": 128}
      }
    },
    "httpsConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "type", "url", "allowed_hosts", "allowed_media_types", "maximum_bytes", "timeout_seconds", "maximum_redirects"],
      "properties": {
        "connector_id": {"$ref": "#/$defs/id"},
        "type": {"const": "https"},
        "url": {"type": "string", "format": "uri", "minLength": 9, "maxLength": 2048},
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"}
        },
        "allowed_media_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"}
        },
        "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "maximum_redirects": {"type": "integer", "minimum": 0, "maximum": 5},
        "auth_secret_ref": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geographies", "languages", "audiences", "subjects"],
      "properties": {
        "geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"}},
        "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "subjects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_from", "valid_until", "expected_refresh_seconds", "stale_action"],
      "properties": {
        "effective_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "expected_refresh_seconds": {"type": "integer", "minimum": 60},
        "stale_action": {"enum": ["block", "warn", "allow"]}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "redistribution", "restrictions"],
      "properties": {
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "redistribution": {"enum": ["permitted", "restricted", "prohibited"]},
        "restrictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "enabled", "publisher", "steward", "authority_class", "connector", "rights", "scope", "freshness", "sensitivity", "distribution"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "enabled": {"type": "boolean"},
        "publisher": {"$ref": "#/$defs/party"},
        "steward": {"$ref": "#/$defs/steward"},
        "authority_class": {"enum": ["official", "delegated", "expert", "community", "advisory", "unverified"]},
        "connector": {"$ref": "#/$defs/httpsConnector"},
        "rights": {"$ref": "#/$defs/rights"},
        "scope": {"$ref": "#/$defs/scope"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "sensitivity": {"enum": ["public", "controlled", "confidential"]},
        "distribution": {"enum": ["public", "deployment", "site", "need_to_know"]}
      }
    }
  }
}
