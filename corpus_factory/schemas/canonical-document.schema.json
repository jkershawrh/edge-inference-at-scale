{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evy.example/schemas/v2/canonical-document.schema.json",
  "title": "CanonicalDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "document_id", "revision", "document_digest", "event_id", "deployment_ids", "scope", "canonical_text", "structured_facts", "source_citations", "transformations", "validity", "authority_rank", "conflict", "safety_class", "permitted_delivery_channels", "review_attestation_ids", "approval_state"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "record_type": {"const": "canonical_document"},
    "document_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}, "document_digest": {"$ref": "#/$defs/digest"},
    "event_id": {"$ref": "#/$defs/id"}, "deployment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "scope": {"$ref": "#/$defs/scope"}, "canonical_text": {"type": "string", "minLength": 1},
    "structured_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "source_citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}},
    "transformations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["tool", "version", "operation"], "properties": {"tool": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1}}}},
    "validity": {"type": "object", "additionalProperties": false, "required": ["valid_from", "valid_until", "review_due_at", "stale_action"], "properties": {"valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": ["string", "null"], "format": "date-time"}, "review_due_at": {"type": "string", "format": "date-time"}, "stale_action": {"enum": ["block", "warn", "allow"]}}},
    "authority_rank": {"type": "integer", "minimum": 0, "maximum": 100},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["state", "explanation", "supersedes"], "properties": {"state": {"enum": ["none", "resolved", "contested"]}, "explanation": {"type": "string"}, "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/documentRevision"}}}},
    "safety_class": {"enum": ["advisory", "standard", "high", "critical"]},
    "permitted_delivery_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["sms", "lora", "discord", "web", "voice"]}},
    "review_attestation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "approval_state": {"enum": ["draft", "in_review", "approved", "rejected"]}
  },
  "allOf": [
    {"if": {"properties": {"approval_state": {"const": "approved"}}, "required": ["approval_state"]}, "then": {"properties": {"conflict": {"properties": {"state": {"enum": ["none", "resolved"]}}}}}},
    {"if": {"properties": {"safety_class": {"const": "critical"}}, "required": ["safety_class"]}, "then": {"properties": {"validity": {"properties": {"stale_action": {"const": "block"}}}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["geographies", "languages", "audiences"], "properties": {"geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"}}, "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "citation": {"type": "object", "additionalProperties": false, "required": ["source_id", "evidence_digest", "location"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "evidence_digest": {"$ref": "#/$defs/digest"}, "location": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["fact_id", "value", "citations"], "properties": {"fact_id": {"$ref": "#/$defs/id"}, "value": {}, "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}}},
    "documentRevision": {"type": "object", "additionalProperties": false, "required": ["document_id", "revision", "digest"], "properties": {"document_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
