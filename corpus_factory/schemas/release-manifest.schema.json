{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://evy.example/schemas/v2/release-manifest.schema.json", "title": "ReleaseManifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "release_uuid", "event_id", "version", "sequence", "previous_release_digest", "recovery_digest", "lifecycle", "scope", "sensitivity_policy", "compatibility", "counts", "derivation", "layers", "evaluation_report_digest", "approval_attestation_digests", "signing", "verification_bundle"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "record_type": {"const": "release_manifest"}, "release_uuid": {"type": "string", "format": "uuid"}, "event_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"}, "sequence": {"type": "integer", "minimum": 1},
    "previous_release_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "recovery_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["created_at", "effective_at", "expires_at", "revoked_at", "revocation_reason"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "effective_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": ["string", "null"], "format": "date-time"}, "revoked_at": {"type": ["string", "null"], "format": "date-time"}, "revocation_reason": {"type": ["string", "null"]}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["site_ids", "geographies", "languages", "audiences"], "properties": {"site_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"}}, "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "sensitivity_policy": {"type": "object", "additionalProperties": false, "required": ["maximum", "policy_digest"], "properties": {"maximum": {"enum": ["public", "controlled", "confidential"]}, "policy_digest": {"$ref": "#/$defs/digest"}}},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["minimum_runtime", "schema_versions", "policy_version", "toolchain_digest"], "properties": {"minimum_runtime": {"type": "string", "minLength": 1}, "schema_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "2.0.0"}}, "policy_version": {"type": "string", "minLength": 1}, "toolchain_digest": {"$ref": "#/$defs/digest"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["sources", "documents", "chunks", "embeddings"], "properties": {"sources": {"type": "integer", "minimum": 1}, "documents": {"type": "integer", "minimum": 1}, "chunks": {"type": "integer", "minimum": 1}, "embeddings": {"type": "integer", "minimum": 0}}},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["chunker_digest", "embedding"], "properties": {"chunker_digest": {"$ref": "#/$defs/digest"}, "embedding": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["model_digest", "dimensions", "normalization"], "properties": {"model_digest": {"$ref": "#/$defs/digest"}, "dimensions": {"type": "integer", "minimum": 1}, "normalization": {"enum": ["none", "l2"]}}}]}}},
    "layers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "media_type", "digest", "byte_size"], "properties": {"name": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "byte_size": {"type": "integer", "minimum": 1}}}},
    "evaluation_report_digest": {"$ref": "#/$defs/digest"}, "approval_attestation_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "signing": {"type": "object", "additionalProperties": false, "required": ["key_id", "algorithm"], "properties": {"key_id": {"$ref": "#/$defs/id"}, "algorithm": {"const": "Ed25519"}}},
    "verification_bundle": {"type": "object", "additionalProperties": false, "required": ["layer_digest", "media_type"], "properties": {"layer_digest": {"$ref": "#/$defs/digest"}, "media_type": {"type": "string", "minLength": 1}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
