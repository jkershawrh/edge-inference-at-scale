{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evy.example/schemas/v2/source-record.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "source_id", "publisher", "steward", "authority_class", "locator", "acquired_at", "last_verified_at", "evidence", "rights", "scope", "freshness", "sensitivity", "distribution"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "source_record"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "publisher": {"$ref": "#/$defs/party"},
    "steward": {"$ref": "#/$defs/personRole"},
    "authority_class": {"enum": ["official", "delegated", "expert", "community", "advisory", "unverified"]},
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference", "acquisition_method", "connector_id", "acquisition_policy_version"],
      "properties": {
        "kind": {"enum": ["url", "api", "file", "physical"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 2048},
        "acquisition_method": {"enum": ["https", "api", "sftp", "manual_upload", "physical_intake"]},
        "connector_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "acquisition_policy_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "acquired_at": {"type": "string", "format": "date-time"},
    "last_verified_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["media_type", "byte_size", "digest"],
      "properties": {
        "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"},
        "byte_size": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["license", "redistribution", "restrictions"],
      "properties": {
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "redistribution": {"enum": ["permitted", "restricted", "prohibited"]},
        "restrictions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "scope": {"$ref": "#/$defs/scope"},
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["effective_from", "valid_until", "expected_refresh_seconds", "stale_action"],
      "properties": {
        "effective_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "expected_refresh_seconds": {"type": "integer", "minimum": 60},
        "stale_action": {"enum": ["block", "warn", "allow"]}
      }
    },
    "sensitivity": {"enum": ["public", "controlled", "confidential"]},
    "distribution": {"enum": ["public", "deployment", "site", "need_to_know"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "party": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "personRole": {"type": "object", "additionalProperties": false, "required": ["identity", "role"], "properties": {"identity": {"type": "string", "minLength": 3, "maxLength": 256}, "role": {"type": "string", "minLength": 2, "maxLength": 128}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["geographies", "languages", "audiences", "subjects"], "properties": {"geographies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"}}, "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "subjects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
