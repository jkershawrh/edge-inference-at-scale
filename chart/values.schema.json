{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "safety": {
      "type": "object",
      "required": ["groundingRequired", "emergencyRagEnabled"],
      "properties": {
        "groundingRequired": {"type": "boolean"},
        "emergencyRagEnabled": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "rag": {
      "type": "object",
      "properties": {
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "storageClassName": {"type": "string"},
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}
            }
          }
        },
        "corpus": {
          "type": "object",
          "required": ["enabled", "eventId", "version", "requireSignature"],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"type": "string"},
            "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
            "eventId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
            "version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
            "requireSignature": {"type": "boolean"},
            "publicKeySecretName": {"type": "string"}
          },
          "allOf": [
            {
              "if": {"properties": {"enabled": {"const": true}}},
              "then": {"properties": {"image": {"minLength": 1}}}
            },
            {
              "if": {"properties": {"requireSignature": {"const": true}}},
              "then": {"properties": {"publicKeySecretName": {"minLength": 1}}}
            }
          ]
        },
        "activation": {
          "type": "object",
          "required": ["enabled", "root"],
          "properties": {
            "enabled": {"type": "boolean"},
            "root": {"type": "string", "pattern": "^/.*$", "minLength": 2},
            "operator": {
              "type": "object",
              "required": [
                "enabled", "port", "intakeRoot", "clusterId", "siteId",
                "bearerSecretName", "bearerSecretKey", "receiptSecretName",
                "receiptPrivateKeyKey", "receiptKeyId", "policyDigest",
                "runtimeVersion", "chunkerDigest", "modelDigest",
                "embeddingModelDigest", "timeConfidence", "maxRequestBytes",
                "resources"
              ],
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
                "intakeRoot": {"type": "string", "pattern": "^/.*$", "minLength": 2},
                "clusterId": {"type": "string"},
                "siteId": {"type": "string"},
                "bearerSecretName": {"type": "string"},
                "bearerSecretKey": {"type": "string", "minLength": 1},
                "receiptSecretName": {"type": "string"},
                "receiptPrivateKeyKey": {"type": "string", "minLength": 1},
                "receiptKeyId": {"type": "string"},
                "policyDigest": {"type": "string"},
                "runtimeVersion": {"type": "string"},
                "chunkerDigest": {"type": "string"},
                "modelDigest": {"type": "string"},
                "embeddingModelDigest": {"type": "string"},
                "timeConfidence": {"enum": ["trusted", "degraded", "unknown"]},
                "maxRequestBytes": {"type": "integer", "minimum": 256, "maximum": 65536},
                "resources": {"type": "object"}
              },
              "allOf": [
                {
                  "if": {"properties": {"enabled": {"const": true}}},
                  "then": {
                    "properties": {
                      "clusterId": {"pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
                      "siteId": {"pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
                      "bearerSecretName": {"minLength": 1},
                      "receiptSecretName": {"minLength": 1},
                      "receiptKeyId": {"pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
                      "policyDigest": {"pattern": "^sha256:[a-f0-9]{64}$"},
                      "runtimeVersion": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
                      "chunkerDigest": {"pattern": "^sha256:[a-f0-9]{64}$"},
                      "modelDigest": {"pattern": "^sha256:[a-f0-9]{64}$"},
                      "embeddingModelDigest": {"pattern": "^sha256:[a-f0-9]{64}$"}
                    }
                  }
                }
              ],
              "additionalProperties": false
            },
            "rollout": {
              "type": "object",
              "required": [
                "enabled", "port", "candidatePath", "targetDigest",
                "targetSequence", "statePath", "apiBearerSecretName",
                "apiBearerSecretKey", "maxActivationAttempts",
                "maxRestartAttempts", "maxStatusPolls", "timeoutSeconds",
                "dependencyTimeoutSeconds", "workerPollSeconds", "resources"
              ],
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
                "candidatePath": {"type": "string"},
                "targetDigest": {"type": "string"},
                "targetSequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
                "statePath": {"type": "string", "pattern": "^/.*$", "minLength": 2},
                "apiBearerSecretName": {"type": "string"},
                "apiBearerSecretKey": {"type": "string", "minLength": 1},
                "maxActivationAttempts": {"type": "integer", "minimum": 1, "maximum": 100},
                "maxRestartAttempts": {"type": "integer", "minimum": 1, "maximum": 100},
                "maxStatusPolls": {"type": "integer", "minimum": 1, "maximum": 10000},
                "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
                "dependencyTimeoutSeconds": {"type": "number", "minimum": 0.1, "maximum": 60},
                "workerPollSeconds": {"type": "number", "minimum": 1, "maximum": 60},
                "resources": {"type": "object"}
              },
              "allOf": [
                {
                  "if": {"properties": {"enabled": {"const": true}}},
                  "then": {
                    "properties": {
                      "candidatePath": {"pattern": "^/.*$", "minLength": 2},
                      "targetDigest": {"pattern": "^sha256:[a-f0-9]{64}$"},
                      "targetSequence": {"minimum": 1},
                      "apiBearerSecretName": {"minLength": 1}
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["activation"],
            "properties": {
              "activation": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            }
          },
          "then": {
            "properties": {
              "corpus": {
                "properties": {
                  "enabled": {"const": false},
                  "publicKeySecretName": {"minLength": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "activation": {
                "properties": {
                  "operator": {
                    "properties": {"enabled": {"const": true}},
                    "required": ["enabled"]
                  }
                },
                "required": ["operator"]
              }
            },
            "required": ["activation"]
          },
          "then": {
            "properties": {
              "activation": {"properties": {"enabled": {"const": true}}},
              "persistence": {"properties": {"enabled": {"const": true}}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "activation": {
                "properties": {
                  "rollout": {
                    "properties": {"enabled": {"const": true}},
                    "required": ["enabled"]
                  }
                },
                "required": ["rollout"]
              }
            },
            "required": ["activation"]
          },
          "then": {
            "properties": {
              "activation": {
                "properties": {
                  "enabled": {"const": true},
                  "operator": {
                    "properties": {"enabled": {"const": true}}
                  }
                }
              },
              "persistence": {"properties": {"enabled": {"const": true}}}
            }
          }
        }
      ]
    }
  }
}
